  "edges": [
    {
      "a": "stop_ticks",
      "b": "be_trigger_ticks",
      "why": "безубыток на +15 при стопе 200 — это 0,075R; соотношение задаёт структурную долю прибыльных stop/(stop+trigger)"
    },
    {
      "a": "be_trigger_ticks",
      "b": "be_offset_ticks",
      "why": "отступ имеет смысл только относительно порога включения"
    },
    {
      "a": "be_trigger_ticks",
      "b": "trail_morning_ticks",
      "why": "трейлинг включается вместе с безубытком; трейлинг короче порога подтягивает стоп выше безубытка сразу"
    },
    {
      "a": "be_trigger_ticks",
      "b": "trail_evening_ticks",
      "why": "то же для вечера"
    },
    {
      "a": "min_range_ticks",
      "b": "max_range_ticks",
      "why": "границы одного окна допуска ширины базы"
    },
    {
      "a": "max_range_ticks",
      "b": "stop_ticks",
      "why": "уровень входа — граница базы; широкая база означает дальний противоположный край"
    },
    {
      "a": "atr_fast",
      "b": "atr_slow",
      "why": "NormVol — их отношение"
    },
    {
      "a": "atr_fast",
      "b": "flat_threshold",
      "why": "порог сравнивается с отношением, зависящим от обоих периодов"
    },
    {
      "a": "atr_slow",
      "b": "flat_threshold",
      "why": "то же"
    },
    {
      "a": "max_entries_per_session",
      "b": "be_trigger_ticks",
      "why": "повторные входы возникают после выходов по безубытку и трейлингу"
    }
  ],
